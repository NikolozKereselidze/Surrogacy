# Runtime connection: copy the pooled URL from Neon (hostname contains -pooler).
DATABASE_URL="postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Migration connection: copy the direct, non-pooled URL from Neon.
DIRECT_URL="postgresql://USER:PASSWORD@ENDPOINT.REGION.aws.neon.tech/DATABASE?sslmode=require"

PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN="http://localhost:3000"

ADMIN_ACCESS_USERNAME=""
ADMIN_ACCESS_PASSWORD=""
ADMIN_JWT_SECRET=""
DONOR_ACCESS_USERNAME=""
DONOR_ACCESS_PASSWORD=""
DONOR_JWT_SECRET=""

S3_ACCESS_KEY=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_REGION=""
S3_BUCKET_NAME=""

SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
